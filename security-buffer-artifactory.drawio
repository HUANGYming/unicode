        <mxCell id="p2_replication" value="Repository replication&lt;br&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;approved repositories only&lt;br&gt;artifacts + metadata&lt;br&gt;checksum / digest verified&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#4F46E5;strokeWidth=2;fontColor=#111827;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="p2_1">

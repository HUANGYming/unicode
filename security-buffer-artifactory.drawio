  <diagram id="new-docker-image-request-flow" name="New Docker Image Request Flow">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="p3_0" />
        <mxCell id="p3_1" parent="p3_0" />

        <mxCell id="p3_bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F7FB;strokeColor=none;" vertex="1" parent="p3_1">
          <mxGeometry x="0" y="0" width="1600" height="1000" as="geometry" />
        </mxCell>

        <mxCell id="p3_title" value="New Docker image request flow" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=34;fontStyle=1;fontColor=#111827;" vertex="1" parent="p3_1">
          <mxGeometry x="70" y="45" width="720" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p3_subtitle" value="What happens when Development Zone needs a Docker image that is not yet available in Dev-side JFrog." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=17;fontColor=#475569;" vertex="1" parent="p3_1">
          <mxGeometry x="72" y="100" width="920" height="30" as="geometry" />
        </mxCell>

        <mxCell id="p3_request_band" value="1. Request" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8EEF9;strokeColor=#CBD5E1;strokeWidth=2;fontSize=20;fontStyle=1;fontColor=#0F172A;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="p3_1">
          <mxGeometry x="55" y="165" width="335" height="635" as="geometry" />
        </mxCell>
        <mxCell id="p3_exploration_band" value="2. Exploration intake" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#CBD5E1;strokeWidth=2;fontSize=20;fontStyle=1;fontColor=#0F172A;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="p3_1">
          <mxGeometry x="420" y="165" width="360" height="635" as="geometry" />
        </mxCell>
        <mxCell id="p3_sync_band" value="3. JFrog mirror sync" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#CBD5E1;strokeWidth=2;fontSize=20;fontStyle=1;fontColor=#0F172A;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="p3_1">
          <mxGeometry x="810" y="165" width="330" height="635" as="geometry" />
        </mxCell>
        <mxCell id="p3_dev_band" value="4. Dev consumption" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#CBD5E1;strokeWidth=2;fontSize=20;fontStyle=1;fontColor=#0F172A;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="p3_1">
          <mxGeometry x="1170" y="165" width="375" height="635" as="geometry" />
        </mxCell>

        <mxCell id="p3_dev_need" value="Dev build needs image&lt;br&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Example: python:3.12-slim&lt;br&gt;or python@sha256:&amp;lt;digest&amp;gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=2;fontColor=#111827;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="p3_1">
          <mxGeometry x="100" y="250" width="245" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p3_dev_check" value="Check Dev JFrog&lt;br&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;docker pull from docker-virtual&lt;br&gt;if not found, submit request&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=2;fontColor=#111827;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="p3_1">
          <mxGeometry x="100" y="415" width="245" height="105" as="geometry" />
        </mxCell>
        <mxCell id="p3_request_record" value="Request record&lt;br&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;image name, tag/digest,&lt;br&gt;source registry, project,&lt;br&gt;business reason&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=2;fontColor=#111827;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="p3_1">
          <mxGeometry x="100" y="585" width="245" height="120" as="geometry" />
        </mxCell>

        <mxCell id="p3_ext_pull" value="Pull from external registry&lt;br&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;performed in Exploration Zone&lt;br&gt;not in Development Zone&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#111827;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="p3_1">
          <mxGeometry x="475" y="235" width="250" height="105" as="geometry" />
        </mxCell>
        <mxCell id="p3_quarantine" value="Push to docker-quarantine&lt;br&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Exploration-side JFrog&lt;br&gt;temporary intake repo&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#111827;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="p3_1">
          <mxGeometry x="475" y="395" width="250" height="105" as="geometry" />
        </mxCell>
        <mxCell id="p3_scanning" value="Scanning&lt;br&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;existing scanner / Xray&lt;br&gt;image layers and metadata&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;fontColor=#111827;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="p3_1">
          <mxGeometry x="475" y="555" width="250" height="105" as="geometry" />
        </mxCell>

        <mxCell id="p3_approved" value="Move to docker-approved&lt;br&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Exploration-side JFrog&lt;br&gt;only approved repo syncs forward&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#4F46E5;strokeWidth=2;fontColor=#111827;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="p3_1">
          <mxGeometry x="855" y="235" width="240" height="105" as="geometry" />
        </mxCell>
        <mxCell id="p3_sync" value="Mirror sync job&lt;br&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;docker-approved only&lt;br&gt;image layers + manifest&lt;br&gt;digest verified&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#4F46E5;strokeWidth=2;fontColor=#111827;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="p3_1">
          <mxGeometry x="855" y="395" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p3_dev_mirror" value="docker-approved-mirror&lt;br&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Development-side JFrog&lt;br&gt;replicated image available&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#4F46E5;strokeWidth=2;fontColor=#111827;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="p3_1">
          <mxGeometry x="855" y="585" width="240" height="105" as="geometry" />
        </mxCell>

        <mxCell id="p3_virtual" value="docker-virtual&lt;br&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;single Dev registry endpoint&lt;br&gt;used by users and CI&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#10B981;strokeWidth=2;fontColor=#111827;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="p3_1">

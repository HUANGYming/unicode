        <mxCell id="p2_title" value="JFrog mirror sync and Development usage" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=34;fontStyle=1;fontColor=#111827;" vertex="1" parent="p2_1">
          <mxGeometry x="70" y="45" width="850" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p2_subtitle" value="A single artifact flow for Python packages, Docker images, and future package types: intake in Exploration, scan, approve, mirror to Development, then consume from Dev JFrog." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=17;fontColor=#475569;" vertex="1" parent="p2_1">
          <mxGeometry x="72" y="100" width="1180" height="34" as="geometry" />
        </mxCell>

        <mxCell id="p2_band_intake" value="1. Exploration intake" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#CBD5E1;strokeWidth=2;fontSize=20;fontStyle=1;fontColor=#0F172A;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="p2_1">
          <mxGeometry x="55" y="165" width="315" height="585" as="geometry" />
        </mxCell>
        <mxCell id="p2_band_jfrog_exploration" value="2. Exploration-side JFrog" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8EEF9;strokeColor=#CBD5E1;strokeWidth=2;fontSize=20;fontStyle=1;fontColor=#0F172A;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="p2_1">
          <mxGeometry x="400" y="165" width="315" height="585" as="geometry" />
        </mxCell>
        <mxCell id="p2_band_sync" value="3. Mirror sync" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#CBD5E1;strokeWidth=2;fontSize=20;fontStyle=1;fontColor=#0F172A;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="p2_1">
          <mxGeometry x="745" y="165" width="340" height="585" as="geometry" />
        </mxCell>
        <mxCell id="p2_band_dev" value="4. Development-side JFrog" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#CBD5E1;strokeWidth=2;fontSize=20;fontStyle=1;fontColor=#0F172A;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="p2_1">
          <mxGeometry x="1115" y="165" width="430" height="585" as="geometry" />
        </mxCell>

        <mxCell id="p2_artifact_request" value="Artifact request&lt;br&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;package / image name&lt;br&gt;version, tag, or digest&lt;br&gt;source registry / index&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#111827;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="p2_1">
          <mxGeometry x="95" y="260" width="235" height="115" as="geometry" />
        </mxCell>
        <mxCell id="p2_external_fetch" value="Fetch in Exploration&lt;br&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;download package&lt;br&gt;or pull image&lt;br&gt;Dev does not access Internet&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#111827;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="p2_1">
          <mxGeometry x="95" y="470" width="235" height="125" as="geometry" />
        </mxCell>

        <mxCell id="p2_quarantine" value="quarantine repo&lt;br&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;pypi-quarantine&lt;br&gt;docker-quarantine&lt;br&gt;future package quarantine&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=2;fontColor=#111827;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="p2_1">

        <mxCell id="p2_sync_status" value="Sync status&lt;br&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;success / retry / failed&lt;br&gt;logged in Artifactory&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#4F46E5;strokeWidth=2;fontColor=#111827;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="p2_1">
          <mxGeometry x="790" y="625" width="240" height="95" as="geometry" />
        </mxCell>

        <mxCell id="p2_dev_mirror" value="approved mirror repo&lt;br&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;pypi-approved-mirror&lt;br&gt;docker-approved-mirror&lt;br&gt;replicated artifacts available&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#10B981;strokeWidth=2;fontColor=#111827;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="p2_1">

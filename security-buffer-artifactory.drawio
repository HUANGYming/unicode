        <mxCell id="p2_usage_python" value="Python / pip&lt;br&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;pip.conf index-url = https://dev-jfrog.example.com/artifactory/api/pypi/pypi-virtual/simple&lt;br&gt;pip install package==version&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=2;fontColor=#111827;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="p2_1">

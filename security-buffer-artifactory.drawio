        <mxCell id="p2_virtual" value="virtual repo endpoint&lt;br&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;pypi-virtual&lt;br&gt;docker-virtual&lt;br&gt;single URL for Dev and CI&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#10B981;strokeWidth=2;fontColor=#111827;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="p2_1">
          <mxGeometry x="1185" y="425" width="285" height="125" as="geometry" />
        </mxCell>
        <mxCell id="p2_dev_consume" value="Dev install / pull&lt;br&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;pip install package==version&lt;br&gt;docker pull image:tag&lt;br&gt;CI uses the same endpoints&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#10B981;strokeWidth=2;fontColor=#111827;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="p2_1">

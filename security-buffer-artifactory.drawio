        <mxCell id="p2_approved" value="approved repo&lt;br&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;pypi-approved&lt;br&gt;docker-approved&lt;br&gt;only this repo syncs forward&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=2;fontColor=#111827;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="p2_1">
